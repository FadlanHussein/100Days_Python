# %% Input Fields in Tkinter

import tkinter as tk

# Main Window
root = tk.Tk()
root.title("Input Field Example")
root.geometry("300x200")

# Input Field
entry = tk.Entry(root, width=25)
entry.pack(pady=10)

# Button to Display Input
def display_input():
    user_input = entry.get()
    print("User Input:", user_input)

button = tk.Button(root, text="Submit", command=display_input)
button.pack(pady=10)

# Run Application
root.mainloop()

# %% Validating User Input

import tkinter as tk

# Main Window
root = tk.Tk()
root.title("Input Field Example")
root.geometry("300x200")

# Input Field
entry = tk.Entry(root)
entry.pack(pady=10)

# Validate Input
def validate_input():
    try:
        value = float(entry.get())
        print(f" Valid Input: {value}")
    except ValueError:
        print(" Invalid Input. Please enter a number.")

button = tk.Button(root, text="Validate", command=validate_input)
button.pack(pady=10)

root.mainloop()

# %% Kasus 3 Dynamic Results

import tkinter as tk

# Main Window
root = tk.Tk()
root.title("Input Field Example")
root.geometry("300x200")

# Input Field
entry = tk.Entry(root)
entry.pack(pady=10)

# Result Label
result_label = tk.Label(root, text="Result will be displayed here.")
result_label.pack(pady=10)

# Update Label
def update_label():
    text = entry.get()
    result_label.config(text=f"You entered: {text}")

button = tk.Button(root, text="Update", command=update_label)
button.pack(pady=10)

root.mainloop()

